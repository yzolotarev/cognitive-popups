[Unit]
Description=Cognitive Popups side panel
After=graphical-session.target cognitive-popups.service
# The panel is a second way into the same daemon; without the daemon it has
# nothing to show, so it lives and dies with the service. Off by default:
#   systemctl --user enable --now cognitive-hud.service
PartOf=cognitive-popups.service graphical-session.target

[Service]
Type=simple
# Rendered by scripts/install-user.sh; rerun it after moving the checkout.
WorkingDirectory=@COGNITIVE_PROJECT@
Environment="COGNITIVE_PROJECT=@COGNITIVE_PROJECT@"
Environment="COGNITIVE_STATE_DIR=%S/cognitive-popups"
Environment=GDK_BACKEND=x11
Environment=XDG_RUNTIME_DIR=%t
ExecStart="@COGNITIVE_PROJECT@/scripts/cognitive-service.sh" -m cognitive_popups.hud
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
