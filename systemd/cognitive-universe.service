[Unit]
Description=Cognitive Popups: grow the reader's universe (verbatim thoughts, concept graph)
After=gemini-web2api.service
Wants=gemini-web2api.service

[Service]
Type=oneshot
# Rendered by scripts/install-user.sh; rerun it after moving the checkout.
WorkingDirectory=@COGNITIVE_PROJECT@
Environment="COGNITIVE_PROJECT=@COGNITIVE_PROJECT@"
Environment="COGNITIVE_STATE_DIR=%S/cognitive-popups"
# Background priority: a person waiting on a hotkey always reaches the model first.
ExecStart="@COGNITIVE_PROJECT@/scripts/cognitive-service.sh" -m cognitive_popups.universe sync --limit 80 --slack
Nice=10
